{
  "manifest_version": 3,
  "name": "Folio: Ebook Library & Reader",
  "version": "1.4.0",
  "description": "Organize and read your EPUB, PDF and TXT books in a private library inside your browser, with optional sync to your own cloud.",
  "action": { "default_title": "Open Folio" },
  "background": { "scripts": ["background.js"] },
  "permissions": ["unlimitedStorage", "identity"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://api.dropboxapi.com/*",
    "https://content.dropboxapi.com/*",
    "https://graph.microsoft.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "folio@etrntyy.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "128.0" }
  }
}
